{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/destination/layout,_N_T_/destination/page,_N_T_/destination"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/destination/__PAGE__",
    "/destination",
    "/_index",
    "/_head"
  ]
}